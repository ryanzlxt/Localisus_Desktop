       <CollectionView
                ItemsSource="{Binding MedicamentosApi}"
                HeightRequest="400">

                    <CollectionView.ItemTemplate>

                        <DataTemplate>

                            <Grid
                BackgroundColor="#E9EEF5"
                ColumnDefinitions="3*,1*,2*"
                Padding="12">

                                <Label
                    Text="{Binding NomeMedicamento}"
                    TextColor="Black"
                    FontAttributes="Bold"/>

                                <Label
                    Grid.Column="1"
                    Text="{Binding Quantidade}"
                    TextColor="Black"
                    HorizontalTextAlignment="Center"/>

                                <Label
                    Grid.Column="2"
                    Text="{Binding Dosagem}"
                    TextColor="Black"
                    HorizontalTextAlignment="Center"/>

                            </Grid>

                        </DataTemplate>

                    </CollectionView.ItemTemplate>

       </CollectionView>


                <!-- Espaço -->

                <BoxView
                    HeightRequest="25"
                    Opacity="0"/>

                <!--

                                =========================
                                      BOTÕES
                                =========================

                -->
                
                    <HorizontalStackLayout
                    HorizontalOptions="End" Spacing="12">
                    
                    
                    <Button
                    Text="VOLTAR" Command="{Binding BotaoVoltar}"
                    WidthRequest="150" HeightRequest="48"
                    CornerRadius="24" BackgroundColor="#808080"
                    TextColor="White" />


                    <Button
                    Text="REMOVER" Command="{Binding BotaoRemoverMedicamento}"
                    WidthRequest="170" HeightRequest="48"
                    CornerRadius="24" BackgroundColor="#808080"
                    TextColor="White" />


                    <Button 
                    Text="ADICIONAR" Command="{Binding BotaoInserirMedicamentos}"
                    WidthRequest="170" HeightRequest="48"
                    CornerRadius="24" BackgroundColor="#001240"
                    TextColor="White" />
                    
                </HorizontalStackLayout>

            </VerticalStackLayout>

