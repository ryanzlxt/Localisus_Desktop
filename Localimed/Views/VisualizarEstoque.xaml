<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Localimed.Views.VisualizarEstoque"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#D8D8D8">

    <Grid RowDefinitions="90,*">

        <!--

                            =========================
                                CABEÇALHO
                            =========================

        -->

        <Border
            Grid.Row="0"
            BackgroundColor="#001240"
            StrokeThickness="0">

            <Grid Padding="25,0">

                <Label
                    Text="LOCALIMED"
                    TextColor="White"
                    FontSize="50"
                    FontAttributes="Bold"
                    VerticalOptions="Center"/>

                <Frame
                    WidthRequest="90"
                    HeightRequest="90"
                    CornerRadius="50"
                    BackgroundColor="White"
                    Padding="5"
                    HasShadow="False"
                    HorizontalOptions="End"
                    VerticalOptions="Center">

                    <Image
                        Source="logopng.png"
                        Aspect="AspectFit"
                        />
                    

                </Frame>

            </Grid>

        </Border>

        <!--

                            =========================
                                CONTEÚDO
                            =========================

        -->

        <Grid Grid.Row="1">

            <!-- CARD -->

            <Border
                WidthRequest="1300"
                HeightRequest="750"
                BackgroundColor="White"
                HorizontalOptions="Center"
                VerticalOptions="Center">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8"/>
                </Border.StrokeShape>

            </Border>

            <VerticalStackLayout
                WidthRequest="1050"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Spacing="15">

                <!--

                                =========================
                                    TÍTULO
                                =========================

                -->

                <Border
                    WidthRequest="550"
                    HeightRequest="50"
                    Padding="6"
                    HorizontalOptions="Center"
                    BackgroundColor="#D9D9D9"
                    Stroke="#A0A0A0">

                    <Label
                        FontSize="28"
                        Text="Estoque de Medicamentos"
                        FontAttributes="Bold"
                        TextColor="Black"
                        HorizontalOptions="Center"/>

                </Border>

                <!--

                                =========================
                                    CABEÇALHO TABELA
                                =========================

                -->

                <Grid
                    BackgroundColor="#001240"
                    ColumnDefinitions="3*,1*,2*"
                    Padding="15"
                    HeightRequest="50">
                    

                    <Label
                        Text="Medicamento"
                        FontAttributes="Bold"
                        TextColor="White"/>

                    <Label
                        Grid.Column="1"
                        Text="Quantidade"
                        FontAttributes="Bold"
                        TextColor="White"
                        HorizontalTextAlignment="Center"/>

                    <Label
                        Grid.Column="2"
                        Text="Dosagem/exige termo"
                        FontAttributes="Bold"
                        TextColor="White"
                        HorizontalTextAlignment="Center"/>

                </Grid>

